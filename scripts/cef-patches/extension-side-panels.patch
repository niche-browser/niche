 namespace extensions::side_panel_util {
 
+// Niche: Niche shows extension side panels in its own windows. While a handler is
+// set, a request for a browser that CEF hosts in a views window goes to it
+// (with that browser's active page) instead of to Chrome's side panel, which
+// CEF's hidden browser view never shows. The handler returns false to leave
+// the request to Chrome.
+enum class NicheSidePanelRequest { kToggle, kOpen, kClose };
+using NicheSidePanelHandler = bool (*)(content::WebContents* web_contents,
+                                     const ExtensionId& extension_id,
+                                     NicheSidePanelRequest request);
+void SetNicheSidePanelHandler(NicheSidePanelHandler handler);
+
