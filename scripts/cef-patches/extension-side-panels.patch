+// Niche: see SetNicheSidePanelHandler.
+NicheSidePanelHandler g_niche_side_panel_handler = nullptr;
+
+// Niche: hands the request to Niche when `browser_window` is a page CEF hosts.
+// `web_contents` defaults to the window's active page. True when Niche took it.
+bool ForwardToNiche(BrowserWindowInterface* browser_window,
+                  content::WebContents* web_contents,
+                  const ExtensionId& extension_id,
+                  NicheSidePanelRequest request) {
+#if BUILDFLAG(ENABLE_CEF)
+  if (!g_niche_side_panel_handler || !browser_window ||
+      !browser_window->cef_delegate() ||
+      !browser_window->cef_delegate()->IsViewsHosted()) {
+    return false;
+  }
+  if (!web_contents) {
+    tabs::TabInterface* tab = GetActiveTab(browser_window);
+    web_contents = tab ? tab->GetContents() : nullptr;
+  }
+  return web_contents &&
+         g_niche_side_panel_handler(web_contents, extension_id, request);
+#else
+  return false;
+#endif
+}
