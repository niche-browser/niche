+
+// Niche: the client chose where the file goes; Chrome decides the rest, as for
+// one of its own downloads (ChromeDownloadManagerDelegate::
+// DetermineEmbedderChosenTarget): danger type, insecure download, .crdownload.
+// Before this the client's path was the whole decision, so no download was ever
+// checked or held for the user, and a half-done file carried its final name.
+// `replace`: a file is already at `path`. The client only hands back such a path
+// when the person chose to replace it (its folder mode picks a free name), so it
+// is overwritten, as after Chrome's own save dialog.
+void RunChosenDownloadTarget(base::WeakPtr<DownloadManager> manager,
+                             uint32_t download_id,
+                             download::DownloadTargetCallback callback,
+                             const base::FilePath& path,
+                             bool replace) {
+  DownloadItem* item = manager ? manager->GetDownload(download_id) : nullptr;
+  auto* delegate =
+      manager ? static_cast<ChromeDownloadManagerDelegate*>(
+                    manager->GetDelegate())
+              : nullptr;
+  if (path.empty() || !item || !delegate ||
+      item->GetState() != DownloadItem::IN_PROGRESS) {
+    RunDownloadTargetCallback(std::move(callback), path);
+    return;
+  }
+  delegate->DetermineEmbedderChosenTarget(item, path, replace,
+                                          std::move(callback));
+}
+
+// Niche: what Chrome decided about a download that CefDownloadItem doesn't
+// carry, for the client's download list. Sent as a "Niche.download" process
+// message from PID_BROWSER before the OnDownloadUpdated that carries a change:
+// [0] the download's id, [1] the path the file gets once done (GetFullPath is
+// the .crdownload while it runs; "" until decided), [2] its danger ("" when
+// none, else "file", "url", "content", "uncommon", "unwanted", "host", "policy"
+// (held with no Keep), "other"), [3] its insecure download status ("" when none,
+// else "warn", "block", or "silent" for one Chrome drops without listing it),
+// [4] whether Chrome blocked the file outright (ended with FILE_BLOCKED).
+// Held downloads wait for Niche.keepDownload or a cancel.
+std::string NicheDanger(const DownloadItem* item) {
+  if (!item->IsDangerous()) {
+    return std::string();
+  }
+  switch (item->GetDangerType()) {
+    case download::DOWNLOAD_DANGER_TYPE_DANGEROUS_FILE:
+      return "file";
+    case download::DOWNLOAD_DANGER_TYPE_DANGEROUS_URL:
+      return "url";
+    case download::DOWNLOAD_DANGER_TYPE_DANGEROUS_CONTENT:
+    case download::DOWNLOAD_DANGER_TYPE_DANGEROUS_ACCOUNT_COMPROMISE:
+      return "content";
+    case download::DOWNLOAD_DANGER_TYPE_UNCOMMON_CONTENT:
+      return "uncommon";
+    case download::DOWNLOAD_DANGER_TYPE_POTENTIALLY_UNWANTED:
+      return "unwanted";
+    case download::DOWNLOAD_DANGER_TYPE_DANGEROUS_HOST:
+      return "host";
+    // Held by policy or for scanning: Chrome offers no Keep.
+    case download::DOWNLOAD_DANGER_TYPE_BLOCKED_PASSWORD_PROTECTED:
+    case download::DOWNLOAD_DANGER_TYPE_BLOCKED_TOO_LARGE:
+    case download::DOWNLOAD_DANGER_TYPE_SENSITIVE_CONTENT_BLOCK:
+    case download::DOWNLOAD_DANGER_TYPE_BLOCKED_SCAN_FAILED:
+    case download::DOWNLOAD_DANGER_TYPE_PROMPT_FOR_SCANNING:
+    case download::DOWNLOAD_DANGER_TYPE_PROMPT_FOR_LOCAL_PASSWORD_SCANNING:
+    case download::DOWNLOAD_DANGER_TYPE_FORCE_SAVE_TO_GDRIVE:
+    case download::DOWNLOAD_DANGER_TYPE_FORCE_SAVE_TO_ONEDRIVE:
+      return "policy";
+    default:
+      return "other";
+  }
+}
+
+std::string NicheInsecure(const DownloadItem* item) {
+  switch (item->GetInsecureDownloadStatus()) {
+    case DownloadItem::InsecureDownloadStatus::WARN:
+      return "warn";
+    case DownloadItem::InsecureDownloadStatus::BLOCK:
+      return "block";
+    // Chrome drops it without a word, and lists nothing.
+    case DownloadItem::InsecureDownloadStatus::SILENT_BLOCK:
+      return "silent";
+    default:
+      return std::string();
+  }
 }
 
+// The last safety sent for an item, so a progress tick sends nothing.
+struct NicheSentSafety : public base::SupportsUserData::Data {
+  std::string state;
+};
+const char kNicheSentSafetyKey[] = "NicheSentSafety";
+
+void NicheSendSafety(CefRefPtr<CefBrowserHostBase> browser,
+                     DownloadItem* item) {
+  // Interrupted, or cancelled before it had a path (an insecure download on a
+  // secure page that Chrome drops without listing it, SILENT_BLOCK).
+  const bool blocked =
+      ((item->GetState() == DownloadItem::INTERRUPTED ||
+        item->GetState() == DownloadItem::CANCELLED) &&
+       item->GetLastReason() ==
+           download::DOWNLOAD_INTERRUPT_REASON_FILE_BLOCKED) ||
+      ChromeDownloadManagerDelegate::WasBlockedOnTarget(item);
+  const std::string danger = NicheDanger(item);
+  const std::string insecure =
+      item->IsInsecure() || item->GetInsecureDownloadStatus() ==
+                                DownloadItem::InsecureDownloadStatus::SILENT_BLOCK
+          ? NicheInsecure(item)
+          : "";
+  const std::string target = item->GetTargetFilePath().AsUTF8Unsafe();
+  const std::string state = target + "|" + danger + "|" + insecure + "|" +
+                            (blocked ? "1" : "0");
+  auto* sent =
+      static_cast<NicheSentSafety*>(item->GetUserData(kNicheSentSafetyKey));
+  if (sent ? sent->state == state : state == "|||0") {
+    return;
+  }
+  // CEF drops a message with no frame to carry it; send it with a later update
+  // rather than remember it as sent.
+  CefRefPtr<CefClient> client = browser->GetClient();
+  CefRefPtr<CefFrame> frame = browser->GetMainFrame();
+  if (!client || !frame) {
+    return;
+  }
+  if (!sent) {
+    auto data = std::make_unique<NicheSentSafety>();
+    sent = data.get();
+    item->SetUserData(kNicheSentSafetyKey, std::move(data));
+  }
+  sent->state = state;
+  CefRefPtr<CefProcessMessage> message =
+      CefProcessMessage::Create("Niche.download");
+  CefRefPtr<CefListValue> args = message->GetArgumentList();
+  args->SetInt(0, static_cast<int>(item->GetId()));
+  args->SetString(1, target);
+  args->SetString(2, danger);
+  args->SetString(3, insecure);
+  args->SetBool(4, blocked);
+  client->OnProcessMessageReceived(browser.get(), frame, PID_BROWSER, message);
+}
