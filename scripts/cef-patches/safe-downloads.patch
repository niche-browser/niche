+namespace {
+// Niche: marks a download whose path the embedder chose (see
+// DetermineEmbedderChosenTarget).
+const char kNicheEmbedderChosenPathKey[] = "NicheEmbedderChosenPath";
+struct NicheEmbedderChosenPath : public base::SupportsUserData::Data {};
+const char kNicheBlockedOnTargetKey[] = "NicheBlockedOnTarget";
+struct NicheBlockedOnTarget : public base::SupportsUserData::Data {};
+}  // namespace
+
+// static
+bool ChromeDownloadManagerDelegate::WasBlockedOnTarget(
+    const DownloadItem* download) {
+  return download->GetUserData(kNicheBlockedOnTargetKey) != nullptr;
+}
+
+void ChromeDownloadManagerDelegate::DetermineEmbedderChosenTarget(
+    DownloadItem* download,
+    const base::FilePath& path,
+    bool replace,
+    download::DownloadTargetCallback callback) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  download->SetUserData(kNicheEmbedderChosenPathKey,
+                        std::make_unique<NicheEmbedderChosenPath>());
+  DownloadTargetDeterminer::Start(
+      download, path,
+      replace ? DownloadPathReservationTracker::OVERWRITE
+              : DownloadPathReservationTracker::UNIQUIFY,
+      download_prefs_.get(), this,
+      base::BindOnce(&ChromeDownloadManagerDelegate::OnDownloadTargetDetermined,
+                     weak_ptr_factory_.GetWeakPtr(), download->GetId(),
+                     std::move(callback)));
 }
 
+// static
+bool ChromeDownloadManagerDelegate::HasEmbedderChosenPath(
+    const DownloadItem* download) {
+  return download->GetUserData(kNicheEmbedderChosenPathKey) != nullptr;
+}
