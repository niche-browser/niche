# Fullscreen, an extension popup and its options page over it, and back: window and Space
# transitions. It takes over a Space, so it runs only with NICHE_SCENARIO_SCREEN=1 (CI).
requires screen
budget rss=600 stalls50=5
niche://debug?installExtension=${FIXTURES}/Extension
relaunch
niche://open?url=${PAGE}?n=full
wait 3
niche://debug?fullscreen=1
wait 3
niche://debug?extensionAction=${EXTENSION_ID}
wait 2
niche://dismiss
niche://open?url=chrome-extension://${EXTENSION_ID}/options.html
wait 3
niche://action/closeTab
niche://debug?fullscreen=0
wait 3
