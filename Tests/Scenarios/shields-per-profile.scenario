wait 1
niche://debug?cdp=Runtime.evaluate&params={"expression":"new Promise(r=>{const s=document.createElement('script');s.src='/shields-first-party-ad.js';s.onload=()=>r('hobbies:'+window.__shields_answered+'-loaded');s.onerror=()=>r('hobbies:'+window.__shields_answered+'-failed');document.head.append(s)})","awaitPromise":true}
