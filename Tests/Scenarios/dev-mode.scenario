# Developer mode toggled on a site and DevTools opened and closed five times, then twice in
# quick succession (the press made while DevTools close: DevToolsToggle).
budget rss=600 stalls50=5
niche://open?url=${PAGE}?n=dev
wait 3
niche://action/toggleDeveloperMode
wait 2
pace 2
repeat 10 niche://action/devTools
pace 0.1
niche://action/devTools
niche://action/devTools
niche://action/devTools
wait 3
pace 0.2
niche://action/toggleDeveloperMode
wait 2
